# BUG: anytermqt v0.1.2 的 RowStore::resize 收窄时裁掉全部历史行；窗口恢复宽度后数据无法恢复。
# NOTE: 仅修改生成的编译副本，保留未改写行的原始宽度；可写行在首次修改时适配当前宽度。
# NOTE: 上游修复且 terminal_tests 的 outputSurvivesResize 回归通过后移除此补丁；尚未提交上游 issue。
set(rowstore_path "${anytermqt_SOURCE_DIR}/pyte/src/rowstore.cpp")
file(READ "${rowstore_path}" rowstore)
set(original_line "    return at(base_ + y);\n}\n\nconst Row *RowStore::line")
set(patched_line "    Row *row = at(base_ + y);\n    if (row != nullptr && row->size() > static_cast<std::size_t>(cols_))\n        row->resize(static_cast<std::size_t>(cols_));\n    return row;\n}\n\nconst Row *RowStore::line")
set(original_resize "            r.resize(static_cast<std::size_t>(cols), fill);")
set(patched_resize "            if (r.size() < static_cast<std::size_t>(cols))\n                r.resize(static_cast<std::size_t>(cols), fill);")
string(FIND "${rowstore}" "${original_line}" line_position)
string(FIND "${rowstore}" "${original_resize}" resize_position)
if(line_position EQUAL -1 OR resize_position EQUAL -1)
    message(FATAL_ERROR "anytermqt source changed; review the terminal history resize patch")
endif()
string(REPLACE "${original_line}" "${patched_line}" rowstore "${rowstore}")
string(REPLACE "${original_resize}" "${patched_resize}" rowstore "${rowstore}")
set(patched_path "${CMAKE_CURRENT_BINARY_DIR}/terminal-dependencies/rowstore.cpp")
file(GENERATE OUTPUT "${patched_path}" CONTENT "${rowstore}")
get_target_property(pyte_sources pyte_core SOURCES)
list(REMOVE_ITEM pyte_sources src/rowstore.cpp)
set_property(TARGET pyte_core PROPERTY SOURCES "${pyte_sources};${patched_path}")
